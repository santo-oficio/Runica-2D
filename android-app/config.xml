<?xml version='1.0' encoding='utf-8'?>
<widget id="com.runika2d.game" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Runika 2D</name>
    <description>Runika 2D — puzzle por turnos</description>
    <author>Javier Q.</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="Orientation" value="landscape" />
    <preference name="Fullscreen" value="true" />
    <preference name="AndroidWindowSplashScreenBackground" value="#1a0f0a" />
    <preference name="AndroidLaunchMode" value="singleInstance" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="WebViewAssetLoader" value="true" />
    <platform name="android">
        <!-- Pantalla completa real: el tema extiende el layout al área del
             notch/cutout (bandas negras laterales en landscape). -->
        <resource-file src="res/android/values/runika-themes.xml" target="app/src/main/res/values/runika-themes.xml" />
        <edit-config file="AndroidManifest.xml" mode="merge" target="/manifest/application/activity">
            <activity android:theme="@style/Theme.Runika" />
        </edit-config>
        <icon foreground="res/icon-foreground.png" background="res/icon-background.png" />
        <icon src="res/icon.png" density="xxxhdpi" />
        <icon src="res/icon.png" density="xxhdpi" />
        <icon src="res/icon.png" density="xhdpi" />
        <icon src="res/icon.png" density="hdpi" />
        <icon src="res/icon.png" density="mdpi" />
        <icon src="res/icon.png" density="ldpi" />
    </platform>
</widget>
