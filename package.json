{
  "name": "runika-2d",
  "version": "0.1.0",
  "private": true,
  "description": "Runika 2D — puzzle con niveles infinitos generados proceduralmente y validados matemáticamente.",
  "type": "module",
  "main": "electron-app/main.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "app": "electron .",
    "calibrate:subworlds:desktop": "node tools/launch-desktop-calibrator.mjs calibrate-submundos.html",
    "calibrate:subworld-text:desktop": "node tools/launch-desktop-calibrator.mjs calibrate-submundos-text.html",
    "calibrate:mapamundi:desktop": "node tools/launch-desktop-calibrator.mjs calibrate-mapamundi.html",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=electron-app/server.mjs",
    "dist": "npm run build:server && electron-builder --win nsis",
    "build:solver": "esbuild web/solver-entry.ts --bundle --platform=browser --format=iife --global-name=RunikaSolver --outfile=web/solver.bundle.js --banner:js=\"var process={argv:[],execArgv:[],env:{},exit:function(){}};\" --alias:node:fs=./web/node-stub.mjs --alias:node:path=./web/node-stub.mjs --alias:node:url=./web/node-stub.mjs --alias:node:child_process=./web/node-stub.mjs",
    "wgt": "npm run build:solver && node tools/build-tizen.mjs",
    "build:android": "node tools/build-android.mjs",
    "apk": "npm run wgt && npm run build:android"
  },
  "build": {
    "appId": "com.runika2d.game",
    "productName": "Runika 2D",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-app/**",
      "*.html",
      "*.js",
      "assets/**",
      "i18n/**",
      "db/**",
      "!db/player.json",
      "!db/settings.json",
      "!db/old/**",
      "!**/old/**",
      "!**/node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron-app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Runika 2D"
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "cordova": "^13.0.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "tsx": "^4.20.5",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
