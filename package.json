    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
