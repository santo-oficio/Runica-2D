{
  "name": "runika-2d",
  "version": "0.1.0",
  "private": true,
  "description": "Runika 2D — Wappo Infinito, puzzle con niveles infinitos generados proceduralmente y validados matemáticamente.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
